// Production data model for PostgreSQL.
// The demo build uses the in-memory store in src/lib/server/store.ts with the same shapes;
// replace those functions with Prisma repository calls when connecting a database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { CITIZEN OFFICER ADMIN }
enum MissionType { EMBASSY CONSULATE MISSION }
enum AppStatus { SUBMITTED UNDER_REVIEW CORRECTION_REQUESTED APPROVED REJECTED READY_FOR_PICKUP DISPATCHED COMPLETED }
enum ApptStatus { BOOKED CANCELLED ATTENDED NO_SHOW }

model Mission {
  id            String        @id @default(cuid())
  slug          String        @unique
  type          MissionType
  region        String
  countryCode   String        @db.Char(2)
  nameAr        String
  nameEn        String
  addressAr     String
  addressEn     String
  phone         String
  emergency     String
  email         String
  timezone      String
  workdays      Int[]
  dailyCapacity Int           @default(40)
  lat           Float
  lng           Float
  verifiedAt    DateTime?
  holidays      Holiday[]
  staff         StaffUser[]
  applications  Application[]
  appointments  Appointment[]
}

model Holiday {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  date      DateTime @db.Date
  nameAr    String
  nameEn    String
  @@unique([missionId, date])
}

model Service {
  id             String  @id @default(cuid())
  slug           String  @unique
  category       String
  titleAr        String
  titleEn        String
  feeMinor       Int     // fee in minor units (cents)
  currency       String  @default("USD")
  processingMin  Int
  processingMax  Int
  inPerson       Boolean
  content        Json    // documents, eligibility, steps (bilingual)
  updatedAt      DateTime @updatedAt
}

model Citizen {
  id              String        @id @default(cuid())
  nationalIdHash  String        @unique // HMAC-SHA256 with a pepper held in KMS
  nationalIdEnc   Bytes         // AES-256-GCM ciphertext
  fullNameEnc     Bytes
  dobEnc          Bytes
  contactEnc      Bytes
  createdAt       DateTime      @default(now())
  applications    Application[]
}

model Application {
  id          String      @id @default(cuid())
  tracking    String      @unique // SY-MOFA-YYYY-XXXXX
  citizenId   String
  citizen     Citizen     @relation(fields: [citizenId], references: [id])
  serviceSlug String
  missionId   String
  mission     Mission     @relation(fields: [missionId], references: [id])
  status      AppStatus   @default(SUBMITTED)
  isDraft     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  documents   Document[]
  events      AppEvent[]
  messages    Message[]
  @@index([missionId, status])
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  objectKey     String      // encrypted object storage key
  wrappedKey    Bytes       // per-object data key wrapped by KMS
  mime          String
  sizeBytes     Int
  sha256        String
  createdAt     DateTime    @default(now())
}

model AppEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  status        AppStatus
  actor         String
  note          String?
  at            DateTime    @default(now())
}

model Message {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  fromStaff     String
  bodyAr        String
  bodyEn        String
  at            DateTime    @default(now())
}

model Appointment {
  id        String     @id @default(cuid())
  code      String     @unique // APT-XXXXXX
  missionId String
  mission   Mission    @relation(fields: [missionId], references: [id])
  service   String
  startsAt  DateTime
  nameEnc   Bytes
  contactEnc Bytes
  status    ApptStatus @default(BOOKED)
  createdAt DateTime   @default(now())
  @@index([missionId, startsAt])
}

model StaffUser {
  id          String   @id @default(cuid())
  username    String   @unique
  name        String
  role        Role
  missionId   String?
  mission     Mission? @relation(fields: [missionId], references: [id])
  idpSubject  String   @unique // subject from the identity provider (OIDC); passwords/MFA live there
  permissions String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id     BigInt   @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String
  action String
  target String
  ip     String?
  meta   Json?
  @@index([at])
}
